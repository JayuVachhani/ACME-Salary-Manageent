{
  "acme-salary-app/apps/**/*.{ts,tsx}": [
    "prettier --check --ignore-path .prettierignore",
    "eslint --config acme-salary-app/eslint.config.mjs --max-warnings 0"
  ],
  "acme-salary-app/{scripts/**/*.mjs,e2e*/**/*.ts,apps/**/*.{css,json,html},*.{json,mjs,ts,yml,yaml}}": "prettier --check --ignore-path .prettierignore",
