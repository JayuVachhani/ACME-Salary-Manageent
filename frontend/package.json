{
  "name": "@acme/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs,html}\"",
    "test": "vitest run",
    "test:architecture": "node scripts/test-web-architecture.mjs",
    "quality:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:architecture"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "@types/node": "26.6.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
