{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"node --env-file=../../.env --watch dist/main.js\"",
