{
  "name": "@acme/repository-quality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "quality:staged": "lint-staged --cwd ../.. --config ../../.lintstagedrc.json --concurrent false && node scripts/verify-staged.mjs",
    "quality:push": "npm --prefix ../../frontend run quality:check && npm --prefix ../../backend run quality:check && npm --prefix ../../qa run typecheck && node scripts/verify-staged.mjs",
    "test:git-safety": "node scripts/test-git-safety.mjs",
    "test:quality-hooks": "node scripts/test-quality-hooks.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"*.json\" \"../../.lintstagedrc.json\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"*.json\" \"../../.lintstagedrc.json\""
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1"
  }
}
