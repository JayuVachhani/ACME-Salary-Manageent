NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://acme_app:replace-locally@127.0.0.1:55432/acme
OTP_TTL_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
FX_MAX_STALENESS_DAYS=7
DEV_INSECURE_COOKIES=true
# Generate locally. Never commit or reuse development secrets in production.
OTP_HMAC_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ACME <no-reply@acme.test>
SMTP_SECURE=false
# Optional SMTP authentication; provide both values together.
SMTP_USER=
SMTP_PASSWORD=

# Owner URL is used only by migration/bootstrap commands.
MIGRATION_DATABASE_URL=postgresql://acme_owner:replace-locally@127.0.0.1:55432/acme
